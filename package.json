{
  "name": "tpower-casino",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "dev:clean": "node scripts/clean-next-cache.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "qa": "node scripts/qa-audit.mjs",
    "assets": "node scripts/generate-assets.mjs",
    "brand:stamp": "node scripts/brand-stamp-images.mjs",
    "brand:restamp": "node scripts/brand-stamp-images.mjs --restamp",
    "games:catalogue": "node scripts/build-games-catalogue.mjs",
    "games:crawl": "node scripts/crawl-tpower-games.mjs",
    "games:pipeline": "node scripts/rebuild-game-asset-pipeline.mjs",
    "games:visual-sync": "node scripts/visual-live-thumb-sync.mjs",
    "games:visual-dom": "node scripts/visual-dom-thumb-sync.mjs",
    "games:provider": "node scripts/providers/run.mjs",
    "games:image-index": "node scripts/build-local-game-image-index.mjs",
    "games:covers": "node scripts/generate-provider-game-covers.mjs",
    "games:covers:force": "node scripts/generate-provider-game-covers.mjs --force",
    "games:restore": "node scripts/restore-clean-game-covers.mjs",
    "games:repair": "node scripts/repair-patched-game-covers.mjs",
    "games:unstamp": "node scripts/unstamp-game-covers.mjs",
    "providers:logos": "node scripts/sync-provider-logos.mjs",
    "cta:banners": "node scripts/make-cta-banners.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "lucide-react": "^1.25.0",
    "next": "^15.5.20",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@opennextjs/cloudflare": "^1.20.1",
    "@tailwindcss/postcss": "^4",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.20",
    "playwright": "^1.51.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.112.0"
  }
}
